{
  "$defs": {
    "IndicatorState": {
      "description": "O que o consumidor precisa saber ANTES de olhar o valor.\n\nMapeado 1-para-1 a partir da disponibilidade dos fatos; nunca inferido do valor.",
      "enum": [
        "measured",
        "partially_measured",
        "not_measured",
        "not_applicable",
        "calculation_failed"
      ],
      "title": "IndicatorState",
      "type": "string"
    },
    "Partiality": {
      "additionalProperties": false,
      "description": "Declara explicitamente se o resultado é completo — em vez de deixar o consumidor\ninferir pela ausência.\n\nNão existe lista de \"indicadores excluídos\" porque a montagem é **fail-closed**: um\nindicador desconhecido ou uma versão incompatível recusam a montagem inteira, não são\nomitidos em silêncio. Logo, todo indicador que os fatos trouxeram está aqui — o que\nvaria é o ESTADO de cada um, e é isso que `reasons` resume.",
      "properties": {
        "complete": {
          "title": "Complete",
          "type": "boolean"
        },
        "reasons": {
          "items": {
            "type": "string"
          },
          "title": "Reasons",
          "type": "array"
        }
      },
      "required": [
        "complete",
        "reasons"
      ],
      "title": "Partiality",
      "type": "object"
    },
    "PublicDenominator": {
      "additionalProperties": false,
      "description": "Sobre o que a razão foi calculada — publicado para permitir auditoria.",
      "properties": {
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "title": "Value",
          "type": "number"
        }
      },
      "required": [
        "kind",
        "value"
      ],
      "title": "PublicDenominator",
      "type": "object"
    },
    "PublicDimension": {
      "additionalProperties": false,
      "description": "Uma dimensão analítica no resultado público.",
      "properties": {
        "coverage": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Coverage"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/IndicatorState"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "id",
        "state",
        "value",
        "coverage"
      ],
      "title": "PublicDimension",
      "type": "object"
    },
    "PublicEvidenceSummary": {
      "additionalProperties": false,
      "description": "Resumo agregado de evidência — só campos da allowlist.\n\n**Sem `excerpt`, e de propósito.** O trecho observado entrou no v3 e SÓ no v3: este modelo é\ncompartilhado pelo v1 e pelo v2, os dois com `additionalProperties: false` no schema\npublicado, e campo novo ali é quebra para quem valida. Ver `PublicEvidenceSummaryV3`.",
      "properties": {
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "label": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Label"
        },
        "observed_count": {
          "title": "Observed Count",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "kind",
        "observed_count",
        "label"
      ],
      "title": "PublicEvidenceSummary",
      "type": "object"
    },
    "PublicIndicator": {
      "additionalProperties": false,
      "description": "Um indicador no resultado público.",
      "properties": {
        "coverage": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Coverage"
        },
        "currency": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Currency"
        },
        "denominator": {
          "anyOf": [
            {
              "$ref": "#/$defs/PublicDenominator"
            },
            {
              "type": "null"
            }
          ]
        },
        "display_precision": {
          "title": "Display Precision",
          "type": "integer"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "kind": {
          "title": "Kind",
          "type": "string"
        },
        "state": {
          "$ref": "#/$defs/IndicatorState"
        },
        "unit": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Unit"
        },
        "value": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "id",
        "state",
        "value",
        "kind",
        "unit",
        "currency",
        "denominator",
        "coverage",
        "display_precision"
      ],
      "title": "PublicIndicator",
      "type": "object"
    },
    "PublicRecommendation": {
      "additionalProperties": false,
      "description": "Recomendação transportada na ordem e prioridade do domínio.",
      "properties": {
        "category": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "title": "Category"
        },
        "evidence_refs": {
          "items": {
            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "id": {
          "title": "Id",
          "type": "string"
        },
        "priority": {
          "title": "Priority",
          "type": "string"
        },
        "title": {
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "title",
        "priority",
        "category",
        "evidence_refs"
      ],
      "title": "PublicRecommendation",
      "type": "object"
    },
    "PublicSummary": {
      "additionalProperties": false,
      "description": "Cabeçalho legível da análise.",
      "properties": {
        "analyzed_at": {
          "title": "Analyzed At",
          "type": "string"
        },
        "record_count": {
          "title": "Record Count",
          "type": "integer"
        }
      },
      "required": [
        "record_count",
        "analyzed_at"
      ],
      "title": "PublicSummary",
      "type": "object"
    }
  },
  "$id": "analysis-result-v1",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Envelope público `analysis-result-v1`.",
  "properties": {
    "analysis_id": {
      "title": "Analysis Id",
      "type": "string"
    },
    "dimensions": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PublicDimension"
      },
      "title": "Dimensions",
      "type": "array"
    },
    "evidence": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PublicEvidenceSummary"
      },
      "title": "Evidence",
      "type": "array"
    },
    "indicators": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PublicIndicator"
      },
      "title": "Indicators",
      "type": "array"
    },
    "measurement_contract_version": {
      "title": "Measurement Contract Version",
      "type": "string"
    },
    "partiality": {
      "$ref": "#/$defs/Partiality"
    },
    "recommendations": {
      "default": [],
      "items": {
        "$ref": "#/$defs/PublicRecommendation"
      },
      "title": "Recommendations",
      "type": "array"
    },
    "result_schema_version": {
      "title": "Result Schema Version",
      "type": "string"
    },
    "summary": {
      "$ref": "#/$defs/PublicSummary"
    }
  },
  "required": [
    "analysis_id",
    "result_schema_version",
    "measurement_contract_version",
    "summary",
    "partiality"
  ],
  "title": "PublicResult",
  "type": "object"
}

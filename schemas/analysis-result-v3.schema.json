            "type": "string"
          },
          "title": "Evidence Refs",
          "type": "array"
        },
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },
        "severity": {
          "minLength": 1,
          "title": "Severity",
          "type": "string"
        },
        "title": {
          "minLength": 1,
          "title": "Title",
          "type": "string"
        }
      },
      "required": [
        "id",
        "severity",
        "code",
        "title"
      ],
      "title": "PublicAlert",
      "type": "object"
    },
    "PublicDenominator": {
      "additionalProperties": false,
      "description": "Sobre o que a razão foi calculada — publicado para permitir auditoria.",
      "properties": {
        "kind": {
          "title": "Kind",

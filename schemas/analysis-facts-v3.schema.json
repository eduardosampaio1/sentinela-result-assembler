    "FactEvidenceSummary": {
      "additionalProperties": false,
      "description": "Resumo de evidência — agregado e seguro por construção.\n\nNão carrega texto livre de conversa, prompt, resposta, caminho, chave nem id interno.\nO que passa é declarado campo a campo aqui; a validação de segurança confere de novo.",
      "properties": {
        "id": {
          "minLength": 1,
          "title": "Id",
          "type": "string"
        },

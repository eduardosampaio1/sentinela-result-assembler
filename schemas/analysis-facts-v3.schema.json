        },
        "observed_count": {
          "minimum": 0,
          "title": "Observed Count",
          "type": "integer"
        }
      },
      "required": [
        "id",
        "kind",
        "observed_count"
      ],
      "title": "FactEvidenceSummary",
      "type": "object"
    },
    "FactExecutiveSummary": {
      "additionalProperties": false,
      "description": "O resumo executivo, textual.\n\n`language` e obrigatorio. Um texto sem idioma declarado nao tem como ser apresentado\nhonestamente a quem le noutro — e o `PublicSummary` do v1, que so tem `analyzed_at` e\n`record_count`, nunca teve onde guardar nem o texto nem o idioma.",
      "properties": {
        "generated_by": {
          "default": "engine",
          "title": "Generated By",
          "type": "string"
        },
        "language": {
          "minLength": 2,
          "title": "Language",
          "type": "string"
        },
        "text": {
          "minLength": 1,
          "title": "Text",
          "type": "string"
        }
      },
      "required": [

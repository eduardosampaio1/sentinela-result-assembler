            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "score": {
          "$ref": "#/$defs/FactMedida"
        },
        "semantic_drift": {
          "anyOf": [
            {
              "$ref": "#/$defs/FactMedida"
            },
